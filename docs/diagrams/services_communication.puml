@startuml Services Communication

title Carpooling and Shared Rides Management - Services Communication

!define RECTANGLE_COLOR #DDDDDD
!define QUEUE_COLOR #FFFFCC
!define DATABASE_COLOR #CCFFCC

skinparam component {
  BackgroundColor RECTANGLE_COLOR
  BorderColor Black
}

skinparam database {
  BackgroundColor DATABASE_COLOR
}

skinparam queue {
  BackgroundColor QUEUE_COLOR
}

' Components
component "Users Service\n✅ PII Encryption\n✅ GraphQL\n✅ Auth/JWT" as UsersService
component "Rides Service\n✅ Location APIs\n✅ CRUD Operations" as RidesService
component "Matching Service\n✅ Algorithm\n✅ Statistics" as MatchingService
component "Payments Service\n✅ Payment Processing\n✅ Transactions" as PaymentsService

' Databases
database "Users DB" as UsersDB
database "Rides DB" as RidesDB
database "Payments DB" as PaymentsDB

' Message Queues
queue "User Events\n✅ RabbitMQ" as UserEvents
queue "Ride Events\n✅ RabbitMQ" as RideEvents
queue "Match Events\n✅ RabbitMQ" as MatchEvents
queue "Payment Events\n✅ RabbitMQ" as PaymentEvents
queue "Logging Queue\n⚠️ Pending" as LogQueue

' Connections between services and databases
UsersService --> UsersDB : CRUD operations
RidesService --> RidesDB : CRUD operations
PaymentsService --> PaymentsDB : CRUD operations

' API connections (synchronous)
UsersService <--> RidesService : REST API
UsersService <--> PaymentsService : REST API
RidesService <--> MatchingService : REST API
MatchingService <--> PaymentsService : REST API

' Message queue connections (asynchronous)
UsersService --> UserEvents : publishes
RidesService --> RideEvents : publishes
MatchingService --> MatchEvents : publishes
PaymentsService --> PaymentEvents : publishes

UserEvents --> RidesService : subscribes
UserEvents --> MatchingService : subscribes
RideEvents --> MatchingService : subscribes
RideEvents --> UsersService : subscribes
MatchEvents --> RidesService : subscribes
MatchEvents --> PaymentsService : subscribes
PaymentEvents --> UsersService : subscribes
PaymentEvents --> RidesService : subscribes

' Logging
UsersService --> LogQueue : logs
RidesService --> LogQueue : logs
MatchingService --> LogQueue : logs
PaymentsService --> LogQueue : logs

note right of UsersService
  ✅ IMPLEMENTED:
  • User profiles with PII encryption
  • JWT authentication & authorization
  • GraphQL unified API endpoint
  • Password hashing with bcrypt
end note

note right of MatchingService
  ✅ IMPLEMENTED:
  • Core matching algorithm
  • Real-time statistics
  • RabbitMQ message processing
  • Health and metrics endpoints
end note

note right of UserEvents
  Messages include:
  - User registered
  - Profile updated
  - User deleted
end note

note right of RideEvents
  Messages include:
  - Ride created
  - Ride status updated
  - Ride completed
end note

@enduml 