@startuml Functional Requirements

title Carpooling and Shared Rides Management - Functional Requirements

' Use case diagram
actor "Passenger" as passenger
actor "Driver" as driver
actor "Admin" as admin

rectangle "Carpooling System" {
  usecase "Register/Login\n✅ IMPLEMENTED" as UC1
  usecase "Manage Profile\n✅ IMPLEMENTED" as UC2
  usecase "Create Ride Request\n✅ IMPLEMENTED" as UC3
  usecase "Offer Ride\n✅ IMPLEMENTED" as UC4
  usecase "Match Rides\n✅ IMPLEMENTED" as UC5
  usecase "Accept/Reject Ride\n✅ IMPLEMENTED" as UC6
  usecase "Process Payment\n✅ IMPLEMENTED" as UC7
  usecase "Rate Experience\n⚠️ PARTIAL" as UC8
  usecase "View Ride History\n✅ IMPLEMENTED" as UC9
  usecase "System Monitoring\n✅ IMPLEMENTED" as UC10
  usecase "Manage Users\n✅ IMPLEMENTED" as UC11
}

' User connections
passenger --> UC1
passenger --> UC2
passenger --> UC3
passenger --> UC6
passenger --> UC7
passenger --> UC8
passenger --> UC9

driver --> UC1
driver --> UC2
driver --> UC4
driver --> UC6
driver --> UC8
driver --> UC9

admin --> UC10
admin --> UC11

' System connections
UC3 ..> UC5 : includes
UC4 ..> UC5 : includes
UC5 ..> UC6 : includes
UC6 ..> UC7 : includes
UC7 ..> UC8 : triggers

note right of UC1
  ✅ IMPLEMENTED:
  • User registration with PII encryption
  • JWT-based authentication
  • Email/password login
  • Profile management with encrypted data
end note

note right of UC5
  ✅ IMPLEMENTED:
  Matching algorithm considers:
  • Location proximity
  • Time constraints
  • Vehicle capacity
  • Real-time statistics
  • RabbitMQ message processing
end note

@enduml 